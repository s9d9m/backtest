{
  "name": "ORB Lab dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "postAttachCommand": {
    "dashboard": "streamlit run app.py --server.headless true --server.port 8501 --server.enableCORS false --server.enableXsrfProtection false"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "ORB Lab dashboard", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["START_HERE.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
